                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/users/signin",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "users", "signin"]
                        },
                        "description": "Authenticate user and get JWT token. Auto-saves token to environment."
                    },
                    "response": []
