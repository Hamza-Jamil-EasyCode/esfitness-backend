                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "stripe-signature",
                                "value": "{{stripeSignature}}",
                                "description": "Stripe webhook signature header"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"api_version\": \"2020-08-27\",\n  \"created\": 1326853478,\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test_payment_intent\",\n      \"object\": \"payment_intent\",\n      \"amount\": 2999,\n      \"currency\": \"usd\",\n      \"status\": \"succeeded\",\n      \"description\": \"Gym membership payment\",\n      \"metadata\": {\n        \"userId\": \"{{userId}}\",\n        \"subscriptionId\": \"{{subscriptionId}}\"\n      }\n    }\n  },\n  \"livemode\": false,\n  \"pending_webhooks\": 1,\n  \"request\": {\n    \"id\": null,\n    \"idempotency_key\": null\n  },\n  \"type\": \"payment_intent.succeeded\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/payments/webhook",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "payments", "webhook"]
                        },
                        "description": "Stripe webhook endpoint for payment_intent.succeeded events."
                    },
                    "response": []
                },
                {
                    "name": "Stripe Webhook (Payment Failed)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "stripe-signature",
                                "value": "{{stripeSignature}}",
                                "description": "Stripe webhook signature header"
